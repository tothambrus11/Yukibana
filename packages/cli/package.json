{
  "name": "@yukibana/cli",
  "version": "0.1.0",
  "description": "Build, publish, submit, download and assemble Yukibana course projects from a terminal: the `yukibana` command, over @yukibana/client.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "yukibana": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "prepack": "npm run build",
    "build:client": "tsc --build ../client/tsconfig.build.json",
    "pretest": "npm run build:client",
    "test": "vitest run",
    "pretypecheck": "npm run build:client",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run build:client",
    "lint": "oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@yukibana/client": "file:../client",
    "uuid": "^14.0.3"
  }
}
