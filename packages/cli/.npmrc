# Do not install a version published in the last three days. The versions
# that carry a supply-chain compromise are the freshly published ones, and
# the window is what gives someone time to notice before we run their code.
# Matches the Dependabot cooldown in .github/dependabot.yml.
#
# Days, not minutes. It filters resolution only: `npm ci` still installs
# exactly what the lockfile pins, so this never blocks a build. npm 11.10
# and later honour it; older npm ignores it without complaining, so it is
# safe to have here before everyone has upgraded.
#
# One per manifest, because npm reads the .npmrc of the package it is
# working on: `npm --prefix packages/cli ci` reads packages/cli/.npmrc and
# not the repository root's.
min-release-age=3
