{
  // Use IntelliSense to learn about possible Node.js debug attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Start Browser Backend",
      "program": "${workspaceRoot}/ide/browser/lib/backend/main.js",
      "args": ["--loglevel=debug", "--port=3000", "--no-cluster"],
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": ["${workspaceRoot}/node_modules/@theia/*/lib/**/*.js", "${workspaceRoot}/ide/**/lib/**/*.js", "${workspaceRoot}/ide/browser/lib/**/*.js"],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Start Electron Backend",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/electron.cmd"
      },
      "program": "${workspaceRoot}/ide/electron/lib/backend/electron-main.js",
      "args": ["--loglevel=debug", "--hostname=localhost", "--no-cluster"],
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": [
        "${workspaceRoot}/ide/electron/lib/backend/electron-main.js",
        "${workspaceRoot}/ide/electron/lib/backend/main.js",
        "${workspaceRoot}/ide/**/lib/**/*.js",
        "${workspaceRoot}/node_modules/@theia/*/lib/**/*.js"
      ],
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "outputCapture": "std"
    }
  ]
}
