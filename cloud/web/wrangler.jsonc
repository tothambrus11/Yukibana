{
  "$schema": "node_modules/wrangler/config-schema.json",

  // This file holds PRODUCTION values, because that is what gets deployed and
  // what must be reviewable in a diff. Local development overrides every one
  // of them through .dev.vars beside it (written by `node cloud/dev/scripts/dev-vars.mjs`, and
  // gitignored):
  // a key there wins over the same key here, and keys only here still apply.
  // The database's local override is `localConnectionString` below.
  // A key there wins over the same key here; keys only here still apply.
  "name": "yukibana-cloud",
  // Paths are from cloud/web, where this file lives beside the app it
  // deploys: `wrangler deploy` runs from there.
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
  "observability": { "enabled": true },

  // No CPU limit override: the Worker is a registry. Archives are built by
  // the CLI before they arrive, so a request here hashes and stores bytes
  // and asks the database, which fits the free plan's allowance.

  // Postgres, pooled by Cloudflare. Create it once with
  //   wrangler hyperdrive create yukibana-cloud --connection-string="<direct connection string>"
  // using Supabase's DIRECT connection string (not a pooler: Hyperdrive is the
  // pool), then paste the id it prints here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "3863f735e3414e4cb20b8b8d59c418ac",
      // Local only. The devcontainer overrides it again through
      // WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE, because
      // "localhost" is a different machine in there.
      "localConnectionString": "postgres://yukibana_app:yukibana@127.0.0.1:54322/postgres",
    },
  ],

  // Secrets are not here: S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and
  // SUPABASE_PUBLISHABLE_KEY are `wrangler secret put` in production and
  // .dev.vars in development. See .dev.vars.example.
  "vars": {
    // https://<project ref>.supabase.co
    "PUBLIC_SUPABASE_URL": "https://zfklzzixyseiyhszkojf.supabase.co",
    // R2's S3 endpoint: https://<account id>.r2.cloudflarestorage.com
    "S3_ENDPOINT": "https://2ee7a3e4d6b972846f17c2a93a7c85a8.r2.cloudflarestorage.com",
    // Where a browser fetches a presigned URL. The same host on R2; a
    // different one locally, where the bucket is a sibling container.
    "S3_PUBLIC_ENDPOINT": "https://2ee7a3e4d6b972846f17c2a93a7c85a8.r2.cloudflarestorage.com",
    "S3_BUCKET": "yukibana-cloud",
    // R2 has one region and calls it "auto". RustFS locally wants a real name.
    "S3_REGION": "auto",
    // The registry's OAuth client on Supabase Auth, through which the CLI and
    // the IDE log in by way of the website (/auth/connect). Printed by
    // `node cloud/dev/scripts/oauth-client.mjs` (docs/cloud/deploy.md, step 7); not a secret.
    // Empty: they log in with GitHub directly, as before.
    "SUPABASE_OAUTH_CLIENT_ID": "5daf9a82-9cae-45ac-b84a-8e9481e1c8f7",
    // The site's canonical address, which must be Auth's site_url
    // (cloud/db/supabase/config.toml): the IDE login works only there, so
    // /auth/connect moves to it, and the CLI is told it.
    "SITE_URL": "https://cloud.yukibana.dev",
    "SUBMISSION_MAX_BYTES": "33554432",
    // Two of these must fit one request under the platform's 100 MB body limit.
    "RELEASE_MAX_BYTES": "41943040",
  },
}
