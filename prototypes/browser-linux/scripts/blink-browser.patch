 static int SysKill(struct Machine *m, int pid, int sig) {
+#ifdef __EMSCRIPTEN__
+  // The browser has one process and no host signals to lend it, so the host
+  // kill() is a stub that does nothing. A signal a process sends itself is
+  // delivered the way tkill() delivers it; no other process exists.
+  if (pid == m->system->pid || pid == 0 || pid == -1) {
+    return SysTkill(m, m->tid, sig);
+  }
+  return esrch();
+#endif
   return kill(pid, sig ? XlatSignal(sig) : 0);
 }
 
