diff --git a/compiler/src/main/java/org/teavm/javac/StdlibConverter.java b/compiler/src/main/java/org/teavm/javac/StdlibConverter.java
index dbc902a..07679a0 100644
--- a/compiler/src/main/java/org/teavm/javac/StdlibConverter.java
+++ b/compiler/src/main/java/org/teavm/javac/StdlibConverter.java
@@ -101,6 +101,17 @@ public class StdlibConverter extends ClassVisitor {
         if (superName.equals(name)) {
             superName = null;
         }
+        // Yukibana: TAnnotation extends java.lang.annotation.Annotation, so
+        // renamed it extends itself, and javac reports "cyclic inheritance"
+        // (or overflows its stack) at the first annotation with an element
+        // value, @Disabled("..."); it is also no annotation type itself.
+        if (interfaces != null) {
+            final String self = name;
+            interfaces = java.util.Arrays.stream(interfaces).filter(i -> !i.equals(self)).toArray(String[]::new);
+        }
+        if (name.equals("java/lang/annotation/Annotation")) {
+            access &= ~Opcodes.ACC_ANNOTATION;
+        }
         super.visit(version, access, name, signature, superName, interfaces);
     }
 
