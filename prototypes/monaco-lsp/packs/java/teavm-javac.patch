@@ -277,9 +277,21 @@ public final class Compiler {
                 .setStrict(strictMode)
                 .build();
         teavm.setOptimizationLevel(TeaVMOptimizationLevel.ADVANCED);
-        new JSOPlugin().install(teavm);
+        // Yukibana: one locale, en_US, as the default and the only one
+        // available: the class library archive carries CLDR's "en" and "root".
+        var properties = new java.util.Properties();
+        properties.setProperty("java.util.Locale.default", "en_US");
+        properties.setProperty("java.util.Locale.available", "en_US");
