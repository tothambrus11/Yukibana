# What a single user program needs, and nothing for devices it never sees.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_RSEQ=y
CONFIG_FILE_LOCKING=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
# No virtual terminals, keyboards or mice: the only console is a serial port.
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_HID_SUPPORT=n
# Boot time under emulation (initcall_debug, x86_64, before -> after): legacy BSD ptys
# register 256 devices (pty_init 1.12 s), and the BLAKE2s self-test runs unless the
# crypto menu says tests are off (blake2s_mod_init 0.48 s). Unix98 ptys stay.
CONFIG_LEGACY_PTYS=n
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# An idle guest (a program blocked reading stdin) should not wake every vCPU 250 times
# a second: each wake-up is a trip through the emulator.
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
