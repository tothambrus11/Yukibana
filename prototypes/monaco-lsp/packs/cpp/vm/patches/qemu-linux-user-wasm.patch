+static uintptr_t guest_lo, guest_hi;
+
+/*
+ * Allocates the guest address space: size bytes aligned to align, zeroed,
+ * recorded for wasm_mmap(). Returns NULL if linear memory cannot grow that far.
+ * It comes from sbrk(), not malloc() and memset(): memory past the break has
+ * never been used (sbrk only moves forward, and Wasm memory starts and grows
+ * zeroed), so it is zero already, and the browser commits only the pages the
+ * guest touches instead of all of them up front.
+ */
+void *wasm_guest_region_alloc(size_t size, size_t align)
+{
+    uintptr_t raw = (uintptr_t)sbrk(size + align);
+    uintptr_t base;
+
+    if (raw == (uintptr_t)-1) {
+        return NULL;
+    }
+    base = ROUND_UP(raw, align);
+    guest_lo = base;
+    guest_hi = base + size;
+    return (void *)base;
+}
+
+static bool in_guest(void *addr, size_t len)
+{
+    uintptr_t a = (uintptr_t)addr;
+    return guest_lo && a >= guest_lo && a <= guest_hi && len <= guest_hi - a;
+}
+
+void *wasm_mmap(void *addr, size_t len, int prot, int flags, int fd, off_t off)
+{
+    if (addr && in_guest(addr, len)) {
+        /* Private copy semantics only: MAP_SHARED writes never reach fd. */
+        memset(addr, 0, len);
+        if (!(flags & MAP_ANONYMOUS) && fd >= 0) {
+            size_t done = 0;
+            while (done < len) {
+                ssize_t r = pread(fd, (char *)addr + done, len - done, off + done);
+                if (r < 0) {
+                    return MAP_FAILED;
+                }
+                if (r == 0) {
+                    break;
+                }
+                done += r;
+            }
+        }
+        return addr;
+    }
+    if (flags & (MAP_FIXED | MAP_FIXED_NOREPLACE)) {
+        errno = ENOMEM;
+        return MAP_FAILED;
+    }
+    return mmap(NULL, len, prot, flags, fd, off);
+}
+
+int wasm_munmap(void *addr, size_t len)
+{
+    if (in_guest(addr, len)) {
+        return 0;
+    }
+    return munmap(addr, len);
+}
+
+/* Wasm memory has no protection: guest page permissions are QEMU's page flags alone. */
+int wasm_mprotect(void *addr, size_t len, int prot)
+{
+    (void)addr;
+    (void)len;
+    (void)prot;
+    return 0;
+}
+
+int wasm_madvise(void *addr, size_t len, int advice)
+{
+    if (advice == MADV_DONTNEED && in_guest(addr, len)) {
+        memset(addr, 0, len);
+    }
+    return 0;
+}
+
+void *wasm_mremap(void *old, size_t old_len, size_t new_len, int flags, ...)
+{
+    (void)old;
+    (void)old_len;
+    (void)new_len;
+    (void)flags;
+    errno = ENOSYS;
+    return MAP_FAILED;
+}
