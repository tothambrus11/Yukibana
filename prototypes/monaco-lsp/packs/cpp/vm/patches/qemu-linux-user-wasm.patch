+/*
+ * Host side of linux-user on an Emscripten (wasm32) host.
+ *
+ * linux-user forwards guest syscalls to host syscalls by number. Emscripten
+ * has no syscall instruction: its libc calls __syscall_<name>() imports
+ * implemented in JS (FS, stdio) or C. This file is the narrow seam: it
+ * provides safe_syscall_base() (no asynchronous host signal can interrupt
+ * a Wasm call, so the race the assembly versions close does not exist),
+ * wasm_host_syscall6(), which maps host syscall numbers onto those functions,
+ * the guest's standard input (wasm_host_stdin), and the guest address space
+ * (wasm_guest_region_alloc, wasm_mmap and friends).
+ */
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include "user/safe-syscall.h"
+#include "special-errno.h"
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <emscripten/emscripten.h>
+#include <emscripten/threading.h>
+#include <sys/uio.h>
+#include <sys/ioctl.h>
+#include <dirent.h>
+#include <linux/futex.h>
+
+char safe_syscall_start[1];
+char safe_syscall_end[1];
+
+long safe_syscall_base(int *pending, long number, ...)
+{
+    va_list ap;
+    long a, b, c, d, e, f, ret;
+
+    if (*pending) {
+        return safe_syscall_set_errno_tail(QEMU_ERESTARTSYS);
+    }
+    va_start(ap, number);
+    a = va_arg(ap, long); b = va_arg(ap, long); c = va_arg(ap, long);
+    d = va_arg(ap, long); e = va_arg(ap, long); f = va_arg(ap, long);
+    va_end(ap);
+    ret = wasm_host_syscall6(number, a, b, c, d, e, f);
+    if (ret < 0 && ret > -4096) {
+        return safe_syscall_set_errno_tail(-ret);
+    }
+    return ret;
+}
+
+/* The libc entry point linux-user's _syscallN() wrappers expand to. */
+long syscall(long n, ...)
+{
+    va_list ap;
+    long a, b, c, d, e, f, ret;
+
+    va_start(ap, n);
+    a = va_arg(ap, long); b = va_arg(ap, long); c = va_arg(ap, long);
+    d = va_arg(ap, long); e = va_arg(ap, long); f = va_arg(ap, long);
+    va_end(ap);
+    ret = wasm_host_syscall6(n, a, b, c, d, e, f);
+    if (ret < 0 && ret > -4096) {
+        errno = -ret;
+        return -1;
+    }
+    return ret;
+}
+
+/*
+ * The guest's standard input: a byte ring in linear memory that the embedder
+ * fills from its own thread and the guest thread reading fd 0 drains,
+ * sleeping on a futex in between. Emscripten's own stdin (FS.init's input
+ * callback, a TTY's get_char) runs on the embedder's thread and cannot wait
+ * there without stopping every proxied file system call, so it is bypassed:
+ * read() and readv() of fd 0 come here (until the guest closes fd 0); every
+ * other call on fd 0 (isatty, fstat, ioctl) still goes to Emscripten's FS.
+ *
+ * Protocol (src/vm/user.js is the embedder and relies on these offsets,
+ * checked below): the embedder writes bytes at data[head % WASM_STDIN_SIZE]
+ * and then advances head, or records an end of file by storing head in
+ * eof_at[eof_written % WASM_STDIN_EOFS] and then advancing eof_written; after
+ * either it increments seq and wakes seq's waiters. The reader advances tail
+ * and eof_read. The embedder must not write more than WASM_STDIN_SIZE - (head
+ * - tail) bytes, nor more than WASM_STDIN_EOFS unread ends of file. Counters
+ * wrap at 2^32.
+ */
+#define WASM_STDIN_SIZE 65536u
+#define WASM_STDIN_EOFS 16u
+
+struct wasm_host_stdin {
+    _Atomic uint32_t seq;          /*  0: bumped by the embedder after each change */
+    _Atomic uint32_t head;         /*  4: bytes written, ever */
+    _Atomic uint32_t tail;         /*  8: bytes read, ever */
+    _Atomic uint32_t eof_written;  /* 12: ends of file recorded, ever */
+    _Atomic uint32_t eof_read;     /* 16: ends of file the guest has read */
+    _Atomic uint32_t enabled;      /* 20: 1 while fd 0 is this ring */
+    _Atomic int32_t exit_signal;   /* 24: the host signal that ended the guest, or 0 */
+    uint32_t size;                 /* 28: WASM_STDIN_SIZE, for the embedder */
+    uint32_t eof_at[WASM_STDIN_EOFS]; /* 32: head at each end of file */
+    uint8_t data[WASM_STDIN_SIZE]; /* 96 */
+};
+QEMU_BUILD_BUG_ON(offsetof(struct wasm_host_stdin, exit_signal) != 24);
+QEMU_BUILD_BUG_ON(offsetof(struct wasm_host_stdin, eof_at) != 32);
+QEMU_BUILD_BUG_ON(offsetof(struct wasm_host_stdin, data) != 96);
+
+static struct wasm_host_stdin wasm_stdin = { .size = WASM_STDIN_SIZE };
+static QemuMutex wasm_stdin_lock;
+
+static void __attribute__((constructor)) wasm_stdin_init(void)
+{
+    qemu_mutex_init(&wasm_stdin_lock);
+}
+
+/*
+ * The ring's address, for the embedder (exported to JS as
+ * Module._wasm_host_stdin). Valid for the life of the module.
+ */
+EMSCRIPTEN_KEEPALIVE void *wasm_host_stdin(void)
+{
+    return &wasm_stdin;
+}
+
+/*
+ * Reads up to len (> 0) bytes of standard input into buf, waiting until there
+ * is at least one byte or an end of file. Like a terminal in canonical mode,
+ * a read returns at most one line, and an end of file is a read of 0 that
+ * input after it does not undo. Guest threads reading at once take turns.
+ */
+static long stdin_read(uint8_t *buf, size_t len)
+{
+    long got = -1;
+
+    qemu_mutex_lock(&wasm_stdin_lock);
+    while (got < 0) {
+        uint32_t seq = atomic_load(&wasm_stdin.seq);
+        uint32_t tail = atomic_load(&wasm_stdin.tail);
+        uint32_t limit = atomic_load(&wasm_stdin.head);
+        uint32_t er = atomic_load(&wasm_stdin.eof_read);
+
+        if (er != atomic_load(&wasm_stdin.eof_written)) {
+            uint32_t at = wasm_stdin.eof_at[er % WASM_STDIN_EOFS];
+            if (at == tail) {
+                atomic_store(&wasm_stdin.eof_read, er + 1);
+                got = 0;
+                break;
+            }
+            limit = at; /* the bytes before that end of file come first */
+        }
+        if (limit != tail) {
+            size_t n = 0;
+            while (n < len && tail + n != limit) {
+                uint8_t ch = wasm_stdin.data[(tail + n) % WASM_STDIN_SIZE];
+                buf[n++] = ch;
+                if (ch == '\n') {
+                    break;
+                }
+            }
+            atomic_store(&wasm_stdin.tail, tail + (uint32_t)n);
+            got = (long)n;
+            break;
+        }
+        emscripten_futex_wait(&wasm_stdin.seq, seq, INFINITY);
+    }
+    qemu_mutex_unlock(&wasm_stdin_lock);
+    return got;
+}
+
+/* readv() of fd 0: fills the first non-empty buffer only (a short read). */
+static long stdin_readv(const struct iovec *iov, int cnt)
+{
+    for (int i = 0; i < cnt; i++) {
+        if (iov[i].iov_len > 0) {
+            return stdin_read(iov[i].iov_base, iov[i].iov_len);
+        }
+    }
+    return 0;
+}
+
+static bool is_stdin(long fd)
+{
+    return fd == 0 && atomic_load(&wasm_stdin.enabled);
+}
+
+/*
+ * Ends the process for a guest killed by host signal sig: records sig for the
+ * embedder (wasm_host_stdin()->exit_signal), then exit(128 + sig), the status
+ * a shell reports. A Wasm process cannot die of a signal.
+ */
+void wasm_host_exit_signal(int sig)
+{
+    atomic_store(&wasm_stdin.exit_signal, sig);
+    exit(128 + sig);
+}
+
+/*
+ * Map a host syscall number (asm-generic numbering, see
+ * wasm-host-syscall.h) onto Emscripten's libc. Returns the result or a
+ * negative errno, like the raw kernel ABI. Anything not listed is -ENOSYS,
+ * which linux-user reports to the guest unchanged: the honest answer for a
+ * host with no processes, signals or kernel objects.
+ */
+#define R(expr) ({ long r_ = (long)(expr); r_ < 0 ? -(long)errno : r_; })
+
+/* Must match host_sigcontext in linux-user/include/host/wasm32/host-signal.h. */
+typedef struct { sigset_t uc_sigmask; } wasm_sigcontext;
+
+/*
+ * Deliver a signal to the calling thread the way a kernel would: call the
+ * SA_SIGINFO handler (QEMU's host_signal_handler) with a real siginfo and
+ * a context whose mask the handler may change, then apply that mask as a
+ * sigreturn would. Emscripten's raise() passes a NULL context, which QEMU
+ * writes through.
+ */
+static long self_signal(int sig)
+{
+    struct sigaction sa;
+    if (sigaction(sig, NULL, &sa)) {
+        return -(long)errno;
+    }
+    if ((sa.sa_flags & SA_SIGINFO) && sa.sa_sigaction) {
+        siginfo_t info;
+        wasm_sigcontext uc;
+        memset(&info, 0, sizeof(info));
+        info.si_signo = sig;
+        info.si_code = SI_TKILL;
+        info.si_pid = getpid();
+        pthread_sigmask(SIG_BLOCK, NULL, &uc.uc_sigmask);
+        sa.sa_sigaction(sig, &info, &uc);
+        pthread_sigmask(SIG_SETMASK, &uc.uc_sigmask, NULL);
+        return 0;
+    }
+    return R(raise(sig));
+}
+
+long wasm_host_syscall6(long n, long a, long b, long c, long d, long e, long f)
+{
+    (void)f;
+    switch (n) {
+    case __NR_read:     return is_stdin(a) ? (c > 0 ? stdin_read((uint8_t *)b, c) : 0)
+                                           : R(read(a, (void *)b, c));
+    case __NR_write:    return R(write(a, (const void *)b, c));
+    case __NR_readv:    return is_stdin(a) ? stdin_readv((const struct iovec *)b, c)
+                                           : R(readv(a, (const struct iovec *)b, c));
+    case __NR_writev:   return R(writev(a, (const struct iovec *)b, c));
+    case __NR_preadv:   return R(preadv(a, (const struct iovec *)b, c,
+                                        (off_t)(((uint64_t)e << 32) | (uint32_t)d)));
+    case __NR_pwritev:  return R(pwritev(a, (const struct iovec *)b, c,
+                                         (off_t)(((uint64_t)e << 32) | (uint32_t)d)));
+    case __NR_openat:   return R(openat(a, (const char *)b, c, (mode_t)d));
+    case __NR_close:
+        if (is_stdin(a)) {
+            atomic_store(&wasm_stdin.enabled, 0); /* a later fd 0 is a file */
+        }
+        return R(close(a));
+    case __NR_ioctl:    return R(ioctl(a, b, c));
+    case __NR_fcntl64:  return R(fcntl(a, b, c));
+    case __NR_getcwd:   return getcwd((char *)a, b) ? (long)strlen((char *)a) + 1
+                                                    : -(long)errno;
+    case __NR_getdents64: return R(getdents(a, (struct dirent *)b, c));
+    case __NR_utimensat: return R(utimensat(a, (const char *)b,
+                                            (const struct timespec *)c, d));
+    case __NR_renameat2: return d ? -ENOSYS
+                                  : R(renameat(a, (const char *)b, c, (const char *)e));
+    case __NR_gettid:   return gettid();
+    /*
+     * Signals to this thread are raised in-process: Emscripten calls the
+     * handler QEMU installed (host_signal_handler) synchronously, which
+     * queues the guest signal. Other threads and processes: ENOSYS.
+     */
+    case __NR_tgkill:   return (a == getpid() && b == gettid()) ? self_signal(c) : -ENOSYS;
+    case __NR_tkill:    return a == gettid() ? self_signal(b) : -ENOSYS;
+    case __NR_kill:     return a == getpid() ? self_signal(b) : -ENOSYS;
+    /* exit(), not _exit(): the embedder hears of it through Module.onExit. */
+    case __NR_exit_group: exit(a);
+    case __NR_nanosleep: return R(nanosleep((const struct timespec *)a,
+                                            (struct timespec *)b));
+    case __NR_clock_nanosleep: {
+        int r = clock_nanosleep(a, b, (const struct timespec *)c,
+                                (struct timespec *)d);
+        return r ? -r : 0;
+    }
+    case __NR_getrandom: {
+        size_t done = 0;
+        while (done < (size_t)b) {
+            size_t chunk = MIN((size_t)b - done, 256);
+            if (getentropy((char *)a + done, chunk)) {
+                return -(long)errno;
+            }
+            done += chunk;
+        }
+        return done;
+    }
+    case __NR_futex:
+    case __NR_futex_time64: {
+        /*
+         * Guest futex words are host addresses (g2h), so Wasm atomics apply.
+         * Host struct timespec has a 64-bit time_t on Emscripten, so both
+         * numbers take the same argument. WAIT is relative, WAIT_BITSET
+         * absolute (CLOCK_MONOTONIC unless FUTEX_CLOCK_REALTIME); bitsets
+         * other than "all" are treated as "all", which only wakes more.
+         */
+        int op = b & FUTEX_CMD_MASK;
+        if (op == FUTEX_WAIT || op == FUTEX_WAIT_BITSET) {
+            const struct timespec *ts = (const struct timespec *)d;
+            double ms = INFINITY;
+            int r;
+            if (ts) {
+                ms = ts->tv_sec * 1e3 + ts->tv_nsec / 1e6;
+                if (op == FUTEX_WAIT_BITSET) {
+                    struct timespec now;
+                    clock_gettime(b & FUTEX_CLOCK_REALTIME ? CLOCK_REALTIME
+                                                           : CLOCK_MONOTONIC, &now);
+                    ms -= now.tv_sec * 1e3 + now.tv_nsec / 1e6;
+                    if (ms < 0) {
+                        ms = 0;
+                    }
+                }
+            }
+            r = emscripten_futex_wait((void *)a, c, ms);
+            return r == -EWOULDBLOCK ? -EAGAIN : r;
+        }
+        if (op == FUTEX_WAKE || op == FUTEX_WAKE_BITSET) {
+            return emscripten_futex_wake((void *)a, c);
+        }
+        return -ENOSYS;
+    }
+    default:
+        return -ENOSYS;
+    }
+}
