+/*
+ * host-signal.h for an Emscripten (wasm32) host.
+ *
+ * A Wasm host never delivers a synchronous SIGSEGV/SIGBUS for a guest
+ * memory access, and has no machine context to rewrite, so these accessors
+ * exist only to satisfy linux-user/signal.c. They must never be reached by
+ * a real fault: host_signal_handler() is not installed for SEGV/BUS on
+ * this host.
+ */
+#ifndef WASM32_HOST_SIGNAL_H
+#define WASM32_HOST_SIGNAL_H
+
+#include <signal.h>
+
+typedef struct { sigset_t uc_sigmask; } host_sigcontext;
+
+static inline uintptr_t host_signal_pc(host_sigcontext *uc) { return 0; }
+static inline void host_signal_set_pc(host_sigcontext *uc, uintptr_t pc) { }
+static inline void *host_signal_mask(host_sigcontext *uc) { return &uc->uc_sigmask; }
+static inline bool host_signal_write(siginfo_t *info, host_sigcontext *uc) { return false; }
+
+#endif
