{
    "name": "yukibana-pack-cpp",
    "private": true,
    "description": "Yukibana C/C++ pack: clangd (LLVM 21.1.8, Emscripten) in a module Web Worker. build.sh builds clangd; this file holds the worker's minifier and the test's browser driver.",
    "type": "module",
    "scripts": {
        "build": "./build.sh",
        "test": "node test.mjs",
        "test:run": "node test-run.mjs",
        "test:targets": "node --test test-targets.mjs",
        "test:emit": "node --test test-emit.mjs",
        "test:demangle": "node test-demangle.mjs",
        "fixtures": "node tests/fixtures/gen.mjs",
        "test:proxying": "node test-proxying.mjs"
    },
    "devDependencies": {
        "esbuild": "0.25.10",
        "playwright-core": "1.56.1"
    }
}
