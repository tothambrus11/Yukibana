+#if SANITIZER_WASI
+// The host's answers (wasi_emscripten.c): frames 0 (the innermost) to
+// n - 1 (the function that holds the code), each one's function, file,
+// line and column, the strings valid until the next call.
+extern "C" {
+int _wasi_pc_frames(uptr pc);
+const char *_wasi_pc_function(uptr pc, int frame);
+const char *_wasi_pc_file(uptr pc, int frame);
+int _wasi_pc_line(uptr pc, int frame);
+int _wasi_pc_column(uptr pc, int frame);
+}
+
+bool EmscriptenSymbolizerTool::SymbolizePC(uptr addr, SymbolizedStack *frame) {
+  int frames = _wasi_pc_frames(addr);
+  if (frames <= 0)
+    return false;
+  // symbolize_inline_frames=0 is llvm-symbolizer --no-inlines: the
+  // innermost line, named after the function that holds it.
+  bool inlines = common_flags()->symbolize_inline_frames;
+  SymbolizedStack *last = frame;
+  for (int i = 0; i < (inlines ? frames : 1); i++) {
+    SymbolizedStack *cur = i ? SymbolizedStack::New(addr) : frame;
+    if (i) {
+      last->next = cur;
+      last = cur;
+    }
+    if (const char *name = _wasi_pc_function(addr, inlines ? i : frames - 1))
+      cur->info.function = internal_strdup(name);
+    if (const char *file = _wasi_pc_file(addr, i)) {
+      cur->info.file = internal_strdup(file);
+      cur->info.line = _wasi_pc_line(addr, i);
+      cur->info.column = _wasi_pc_column(addr, i);
+    } else {
+      // No line table: the module and the offset in it, as natively.
+      static char module[kMaxPathLength];
+      if (!module[0])
+        ReadBinaryNameCached(module, sizeof(module));
+      cur->info.FillModuleInfo(module, addr, kModuleArchUnknown);
+    }
+  }
+  return true;
+}
