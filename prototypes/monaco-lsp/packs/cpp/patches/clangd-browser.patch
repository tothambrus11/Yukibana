+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#include <condition_variable>
+#include <cstring>
+
+// A browser has no stdin. clangd's main runs on a thread of its own
+// (-sPROXY_TO_PTHREAD), and the Worker that loaded it hands it the client's
+// messages, framed, by calling clangd_input; the transport reads them through
+// a FILE that waits while there is nothing to read.
+namespace {
+std::mutex InputMu;
+std::condition_variable InputArrived;
+std::string Input;
+size_t InputRead = 0;
+
+ssize_t readInput(void *, char *Buf, size_t Size) {
+  std::unique_lock<std::mutex> Lock(InputMu);
+  InputArrived.wait(Lock, [] { return InputRead < Input.size(); });
+  size_t N = std::min(Size, Input.size() - InputRead);
+  std::memcpy(Buf, Input.data() + InputRead, N);
+  InputRead += N;
+  if (InputRead == Input.size()) {
+    Input.clear();
+    InputRead = 0;
+  }
+  return N;
+}
+} // namespace
+
+extern "C" EMSCRIPTEN_KEEPALIVE void clangd_input(const char *Data,
+                                                  size_t Size) {
+  {
+    std::lock_guard<std::mutex> Lock(InputMu);
+    Input.append(Data, Size);
+  }
+  InputArrived.notify_one();
+}
+#endif
+
