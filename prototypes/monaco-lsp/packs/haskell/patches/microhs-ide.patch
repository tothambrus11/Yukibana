   deriving (Show)
 
+-- Yukibana: a name as the module uses it (or binds it in a pattern), for an
+-- editor's hover and go to definition: the occurrence (its SLoc is where it
+-- is written), what it resolved to (an EVar whose SLoc is the definition),
+-- its type as declared, and the type at this use, the mode it was checked
+-- in (value or type). The types may hold unification variables until the
+-- definition is done; ideFlush substitutes them at its tcReset.
+type IdeUse = (Ident, Expr, EType, EType, TCMode)
+
+-- Yukibana: substitutes what the type checker learnt for its unification
+-- variables. The substitution is reset before each top-level definition
+-- (tcReset), so the uses of a definition are substituted then.
+ideDeref :: IM.IntMap EType -> EType -> EType
+ideDeref m t =
+  case t of
+    EApp f a -> EApp (ideDeref m f) (ideDeref m a)
+    EUVar r -> maybe t (ideDeref m) (IM.lookup r m)
+    ESign a k -> ESign (ideDeref m a) k
+    EForall b vs a -> EForall b vs (ideDeref m a)
+    _ -> t
+
+ideFlush :: TCState -> TCState
+ideFlush ts =
+  let d = ideDeref (uvarSubst ts)
+  in  ts{ ideUses = [ (i, e, d t, d a, m) | (i, e, t, a, m) <- idePending ts ] ++ ideUses ts, idePending = [] }
+
