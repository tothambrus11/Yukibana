+-- Yukibana: remember a use of a name for the editor (TCMonad's IdeUse);
+-- the type at the use is the expected one, which for Infer is the
+-- reference instSigma sets. What the name resolved to is looked up again:
+-- tLookup gives it the use's location, and the editor wants the
+-- definition's.
+ideUse :: Ident -> Expr -> EType -> Expected -> T ()
+ideUse i e0 t mt = do
+  tcm <- gets tcMode
+  env <- gets valueTable
+  let at = case mt of { Check x -> x; Infer r -> EUVar r }
+      e = case stLookup "" i env of { Right (Entry x _) -> x; Left _ -> e0 }
+  modify $ \ ts -> ts{ idePending = (i, e, t, at, tcm) : idePending ts }
+
