From 07ab265a5b984015154453e9acf5afa2f8e605a7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 22 Oct 2026 11:17:56 +0000
Subject: [PATCH] tcg/wasm32: fix 32-bit carry, sub2_i64 validation, i32
 extract and clz/ctz

add2_i32/sub2_i32 shared the i64 code path, so the carry or borrow was taken
from a 64-bit add of the low halves instead of from bit 32. AArch64 guests use
add2_i32 for ADDS/CMN on W registers, so once a block was JIT-compiled to Wasm
the C flag was wrong. In a Linux guest this showed up as vsnprintf no longer
recognising digits ("unsupported %1 in format string", missing printk
timestamps, a duplicate sysfs "index" entry). Build the 64-bit pair from the
two halves and split the result instead.

sub2_i64 pushed the i32 result of i64.gt_u straight into i64.sub, producing a
module that fails validation.

extract_i32/sextract_i32 used 32-bit shift amounts with i64 shifts, so bits
above pos + len were not cleared; clz_i32/ctz_i32 tested all 64 bits for zero.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01DRJv3qf2Y68wM5dFjKJXaH
---
 tcg/wasm32/tcg-target.c.inc | 65 +++++++++++++++++++++++++++++++++----
 1 file changed, 59 insertions(+), 6 deletions(-)

diff --git a/tcg/wasm32/tcg-target.c.inc b/tcg/wasm32/tcg-target.c.inc
index 3c85588be9..a096012359 100644
--- a/tcg/wasm32/tcg-target.c.inc
+++ b/tcg/wasm32/tcg-target.c.inc
@@ -885,7 +885,8 @@ static void tcg_wasm_out_clz64(TCGContext *s, TCGReg ret, TCGReg arg1, TCGReg ar
 
 static void tcg_wasm_out_clz32(TCGContext *s, TCGReg ret, TCGReg arg1, TCGReg arg2){
     tcg_wasm_out_op_global_get_r(s, arg1);
-    tcg_wasm_out_op_i64_eqz(s);
+    tcg_wasm_out_op_i32_wrap_i64(s);
+    tcg_wasm_out_op_i32_eqz(s);
     tcg_wasm_out_op_if_ret_i32(s);
     tcg_wasm_out_op_global_get_r(s, arg2);
     tcg_wasm_out_op_i32_wrap_i64(s);
@@ -912,7 +913,8 @@ static void tcg_wasm_out_ctz64(TCGContext *s, TCGReg ret, TCGReg arg1, TCGReg ar
 
 static void tcg_wasm_out_ctz32(TCGContext *s, TCGReg ret, TCGReg arg1, TCGReg arg2){
     tcg_wasm_out_op_global_get_r(s, arg1);
-    tcg_wasm_out_op_i64_eqz(s);
+    tcg_wasm_out_op_i32_wrap_i64(s);
+    tcg_wasm_out_op_i32_eqz(s);
     tcg_wasm_out_op_if_ret_i32(s);
     tcg_wasm_out_op_global_get_r(s, arg2);
     tcg_wasm_out_op_i32_wrap_i64(s);
@@ -1384,6 +1386,43 @@ static void tcg_wasm_out_movcond_i64(TCGContext *s, TCGCond cond, TCGReg ret,
     tcg_wasm_out_op_global_set_r(s, ret);
 }
 
+/*
+ * add2_i32/sub2_i32 operate on two 32-bit halves. Registers are 64-bit wasm
+ * globals whose upper 32 bits are undefined for i32 values, so the carry or
+ * borrow must come out of bit 32 of a (hi:lo) pair, not out of a 64-bit add
+ * of the low halves. Computing it in 64 bits (as the i64 variants do) loses
+ * the carry of e.g. 0xfffffff7 + 0xa, which broke AArch64 "adds/cmn wN" and
+ * with it every "isdigit" in the guest kernel's vsnprintf.
+ */
+static void tcg_wasm_out_pair_i32(TCGContext *s, TCGReg lo, TCGReg hi)
+{
+    tcg_wasm_out_op_global_get_r(s, hi);
+    tcg_wasm_out_op_i64_const(s, 32);
+    tcg_wasm_out_op_i64_shl(s);
+    tcg_wasm_out_op_global_get_r(s, lo);
+    tcg_wasm_out_op_i64_const(s, 0xffffffff);
+    tcg_wasm_out_op_i64_and(s);
+    tcg_wasm_out_op_i64_or(s);
+}
+
+static void tcg_wasm_out_add2_i32(TCGContext *s, TCGReg retl, TCGReg reth,
+                                  TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
+{
+    tcg_wasm_out_pair_i32(s, al, ah);
+    tcg_wasm_out_pair_i32(s, bl, bh);
+    tcg_wasm_out_op_i64_add(s);
+    tcg_wasm_out_op_set_r_as_i64(s, retl, reth);
+}
+
+static void tcg_wasm_out_sub2_i32(TCGContext *s, TCGReg retl, TCGReg reth,
+                                  TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
+{
+    tcg_wasm_out_pair_i32(s, al, ah);
+    tcg_wasm_out_pair_i32(s, bl, bh);
+    tcg_wasm_out_op_i64_sub(s);
+    tcg_wasm_out_op_set_r_as_i64(s, retl, reth);
+}
+
 static void tcg_wasm_out_add2(TCGContext *s, TCGReg retl, TCGReg reth,
                              TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
 {
@@ -1443,6 +1482,7 @@ static void tcg_wasm_out_sub2(TCGContext *s, TCGReg retl, TCGReg reth,
         tcg_wasm_out_op_local_get(s, TMP64_0_IDX);
         tcg_wasm_out_op_global_get_r(s, al);
         tcg_wasm_out_op_i64_gt_u(s);
+        tcg_wasm_out_op_i64_extend_i32_u(s);
 
         tcg_wasm_out_op_local_get(s, TMP64_0_IDX);
         tcg_wasm_out_op_global_set_r(s, retl);
@@ -1452,6 +1492,7 @@ static void tcg_wasm_out_sub2(TCGContext *s, TCGReg retl, TCGReg reth,
         tcg_wasm_out_op_global_get_r(s, retl);
         tcg_wasm_out_op_global_get_r(s, al);
         tcg_wasm_out_op_i64_gt_u(s);
+        tcg_wasm_out_op_i64_extend_i32_u(s);
     }
 
     tcg_wasm_out_op_i64_sub(s);
@@ -1552,11 +1593,15 @@ static void tcg_wasm_out_deposit_i64(TCGContext *s, TCGReg dest, TCGReg arg1, TC
 
 static void tcg_wasm_out_extract(TCGContext *s, TCGReg dest, TCGReg arg1, int pos, int len, TCGType type, bool sign)
 {
+    /*
+     * The shifts below are i64 shifts for both types: shifting by 32 - len
+     * left bits above pos + len (and the undefined upper half of an i32
+     * register) in the result. pos + len <= 32 for i32, so the 64-bit
+     * amounts give the right low 32 bits, zero- or sign-extended.
+     */
     int rs;
     switch (type) {
     case TCG_TYPE_I32:
-        rs = 32 - len;
-        break;
     case TCG_TYPE_I64:
         rs = 64 - len;
         break;
@@ -3279,13 +3324,21 @@ static void tcg_out_add2(TCGContext *s, TCGOpcode opc, TCGReg retl, TCGReg reth,
                          TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
 {
     tcg_tci_out_op_rrrrrr(s, opc, retl, reth, al, ah, bl, bh);
-    tcg_wasm_out_add2(s, retl, reth, al, ah, bl, bh);
+    if (opc == INDEX_op_add2_i32) {
+        tcg_wasm_out_add2_i32(s, retl, reth, al, ah, bl, bh);
+    } else {
+        tcg_wasm_out_add2(s, retl, reth, al, ah, bl, bh);
+    }
 }
 static void tcg_out_sub2(TCGContext *s, TCGOpcode opc, TCGReg retl, TCGReg reth,
                          TCGReg al, TCGReg ah, TCGReg bl, TCGReg bh)
 {
     tcg_tci_out_op_rrrrrr(s, opc, retl, reth, al, ah, bl, bh);
-    tcg_wasm_out_sub2(s, retl, reth, al, ah, bl, bh);
+    if (opc == INDEX_op_sub2_i32) {
+        tcg_wasm_out_sub2_i32(s, retl, reth, al, ah, bl, bh);
+    } else {
+        tcg_wasm_out_sub2(s, retl, reth, al, ah, bl, bh);
+    }
 }
 static void tcg_out_mulu2_i32(TCGContext *s, TCGOpcode opc, TCGReg retl, TCGReg reth, TCGReg arg1, TCGReg arg2)
 {
-- 
2.43.0

