.DS_Store
**/node_modules
**/.browser_modules
**/dist
# tsc's output, in the IDE and the packages; a src/lib/ (SvelteKit's $lib, the client's library) is source.
/ide/**/lib/
/packages/*/lib/
**/src-gen
**/gen-esbuild.*.mjs
**/plugins
**/*.tsbuildinfo
*.log
**/test-screenshots
**/test-results
**/playwright-report
**/coverage

.idea

# The cloud's local secrets (this repository is public) and Worker state.
.env
.env.local
.dev.vars
.wrangler/
# SvelteKit's generated files and the Worker's build.
.svelte-kit/
/cloud/web/build/
# The Supabase CLI's local state, and the local bucket's data when run without Docker.
supabase/.temp/
supabase/.branches/
/cloud/dev/data/
# direnv (cloud/dev/.envrc), and nyc's coverage data.
.direnv/
.nyc_output/
